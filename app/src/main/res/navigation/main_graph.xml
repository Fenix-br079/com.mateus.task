<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/splashFragment">
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.mateus.task.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action android:id="@+id/action_splashFragment_to_authentication"
            app:destination="@id/authentication" />
    </fragment>
    <navigation android:id="@+id/authentication" app:startDestination="@id/loginFragment">
        <fragment android:id="@+id/loginFragment"
            android:name="com.mateus.task.ui.auth.LoginFragment"
            android:label="Login" tools:layout="@layout/fragment_login">
            <action android:id="@+id/action_loginFragment_to_registerFragment" app:destination="@id/registerFragment" />
            <action android:id="@+id/action_loginFragment_to_recoverAccountFragment" app:destination="@id/recoverAccountFragment" />
        </fragment>
        <fragment android:id="@+id/registerFragment"
            android:name="com.mateus.task.ui.auth.RegisterFragment"
            android:label="Cadastro" tools:layout="@layout/fragment_register" />
        <fragment android:id="@+id/recoverAccountFragment"
            android:name="com.mateus.task.ui.auth.RecoverAccountFragment"
            android:label="Recuperar conta" tools:layout="@layout/fragment_recover_account" />
        <action android:id="@+id/action_authentication_to_homeFragment"
            app:destination="@id/homeFragment" />
    </navigation>
    <fragment android:id="@+id/homeFragment"
        android:name="com.mateus.task.ui.HomeFragment"
        android:label="Tarefas" tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/authentication" />
    </fragment>
</navigation>
